#!/bin/sh

set -eu

project_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_root"

python3 -m unittest discover -s tests -p 'test_*.py'

if command -v shellcheck >/dev/null 2>&1; then
  shellcheck worker-launcher.sh tests/run scripts/*.sh
fi

if command -v cargo >/dev/null 2>&1; then
  cargo fmt --all -- --check
  cargo clippy --all-targets -- -D warnings
  cargo test --all-targets
fi

if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate "$project_root"
fi

if command -v qmllint >/dev/null 2>&1 && [ -d /usr/share/omarchy/shell ]; then
  qmllint -I /usr/share/omarchy/shell Bookmarks.qml WorkerClient.qml
fi
